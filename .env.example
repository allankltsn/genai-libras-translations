# Copie para .env (git-ignorado). Somente PLACEHOLDERS aqui; nunca coloque segredos neste arquivo.
# Arquivo (fora do repositorio) com os segredos do 9router, um por linha, formato KEY=VALUE:
# INITIAL_PASSWORD, JWT_SECRET, API_KEY_SECRET, MACHINE_ID_SALT.
# Barras normais mesmo no Windows, caminho absoluto.
NINEROUTER_SECRETS_FILE=C:/Users/<seu-usuario>/.9router-poc/secrets.env

# Redis (cache de sinais gerados). Senha: troque por um valor aleatorio SEM espacos/aspas,
# ex.: PowerShell/Git Bash `openssl rand -hex 24`. Nunca commite o .env.
REDIS_PASSWORD=<gere-uma-senha-aleatoria-hex>
# TTL do cache em segundos (padrao 2592000 = 30 dias). Opcional.
# CACHE_TTL_S=2592000
