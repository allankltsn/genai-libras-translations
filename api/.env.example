# Copie para api/.env (git-ignorado). NUNCA coloque chaves reais neste arquivo de exemplo.
LLM_PROVIDER=fake
# Para usar o 9router local:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://127.0.0.1:20128/v1
# LLM_API_KEY=<chave criada no painel do 9router>
# LLM_MODEL=<nome de modelo mostrado no painel do 9router>
LLM_TIMEOUT_S=20
# structured (function calling) ou json_text (JSON pedido no prompt; mais portavel)
LLM_OUTPUT_MODE=structured
ALLOW_GENERATED_POSES=true
GENERATED_MAX_PER_PHRASE=12
GENERATED_CONCURRENCY=4
# Cache do dicionario gerado: vazio = memoria. No compose: REDIS_URL=redis://redis:6379/0 e REDIS_PASSWORD (variavel separada).
REDIS_URL=
REDIS_PASSWORD=
# 0 = sem expiracao (o compose usa 2592000 = 30 dias)
CACHE_TTL_S=0
RATE_LIMIT_PER_MIN=30
# Tracing (LangSmith/LangChain) e proibido: o servico recusa iniciar se estiver ligado.
